# Copy to .env.local for development, and set these as encrypted environment
# variables in the hosting dashboard for production. Never commit real values.

# Canonical public origin. Must be https in production. Used for cookie scope,
# links in email, and the strict Origin check on state-changing requests.
SITE_ORIGIN=https://getyourhour.example

# Point at a POOLED connection string (PgBouncer / Neon / Supabase pooler).
# Serverless invocations open many short-lived connections; a direct endpoint
# will exhaust its connection limit under load.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# 32+ chars of real entropy. Generate with: openssl rand -base64 48
# Rotating this logs everyone out and re-anonymises stored IP hashes.
SECRET_KEY=

# 32+ chars. Vercel Cron sends this automatically as a bearer token once set.
# Generate with: openssl rand -base64 48
CRON_SECRET=

# Polar. The access token is a live payment credential -- treat it accordingly.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=whsec_...
POLAR_PRODUCT_ID=

# Resend. EMAIL_FROM must be a domain you have verified for sending.
RESEND_API_KEY=
EMAIL_FROM=GetYourHour <hours@getyourhour.example>

# Comma-separated user UUIDs permitted to reach /api/moderation.
MODERATOR_USER_IDS=

# --- Auction tuning (all optional; the defaults shown are the built-in ones) ---
# MIN_BID_CENTS=100
# MIN_INCREMENT_CENTS=100
# MAX_BID_CENTS=10000000
# Ceiling for bidders who have not confirmed their email. Bidding needs no
# sign-in, so this bounds how much damage a throwaway address can do by
# winning an hour and never paying. Set to 0 to require verification always.
# MAX_UNVERIFIED_BID_CENTS=5000
# PAYMENT_WINDOW_SECONDS=300
# CHARITY_BASIS_POINTS=5000
# FEE_BASIS_POINTS=290
# FEE_FIXED_CENTS=30

# Leave false to hold listings for review before they appear on the homepage.
# Setting it true puts unreviewed user-supplied text in front of every visitor.
# LISTING_AUTO_APPROVE=false
